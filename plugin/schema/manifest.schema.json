{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intelli-expense.local/schema/agent-import-manifest.schema.json",
  "title": "Intelli-Expense Agent Import Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "generatedAt",
    "inboxPath",
    "processedPath",
    "failedPath",
    "trips"
  ],
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "const": 1
    },
    "generatedAt": {
      "type": "string"
    },
    "inboxPath": {
      "type": "string",
      "minLength": 1
    },
    "processedPath": {
      "type": "string",
      "minLength": 1
    },
    "failedPath": {
      "type": "string",
      "minLength": 1
    },
    "trips": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "receiptCount",
          "currenciesPresent",
          "archived"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "startDate": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "endDate": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "receiptCount": {
            "type": "integer",
            "minimum": 0
          },
          "currenciesPresent": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "uniqueItems": true
          },
          "archived": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
